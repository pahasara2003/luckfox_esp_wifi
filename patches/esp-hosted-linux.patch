@@ -1864,8 +1866,31 @@ static void set_gpio_cd_pin(void)
 #endif
 }
 
+/* Luckfox: SuperMini has no EN on the header, so the host reset line goes to GPIO1.
+ * The host pulse is only ~0.3 ms, so latch the falling edge in an ISR and
+ * restart once the line is high again (restarting while low would loop). */
+#define HOST_RESET_GPIO 1
+static volatile bool host_reset_seen;
+static void IRAM_ATTR host_reset_isr(void *arg) { host_reset_seen = true; }
+static void host_reset_task(void *arg)
+{
+	gpio_config_t c = { .pin_bit_mask = 1ULL << HOST_RESET_GPIO, .mode = GPIO_MODE_INPUT,
+		.pull_up_en = GPIO_PULLUP_ENABLE, .intr_type = GPIO_INTR_NEGEDGE };
+	gpio_config(&c);
+	gpio_install_isr_service(0);
+	gpio_isr_handler_add(HOST_RESET_GPIO, host_reset_isr, NULL);
+	for (;;) {
+		if (!gpio_get_level(HOST_RESET_GPIO))
+			host_reset_seen = true;
+		else if (host_reset_seen)
+			esp_restart();
+		vTaskDelay(pdMS_TO_TICKS(5));
+	}
+}
+
 void app_main()
 {
+	xTaskCreate(host_reset_task, "host_rst", 2048, NULL, 5, NULL);
     esp_err_t ret;
     uint8_t prio_q_idx = 0;
     uint32_t capa = 0;
